#include <windows.h>

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Cache_Rikka"
            VALUE "FileDescription", "MCT - Minecraft Terminal Launcher"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "mct"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "mct.exe"
            VALUE "ProductName", "MCT Designed By Cache_Rikka"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
